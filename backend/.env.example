FLASK_APP=run.py
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/utsav
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OTP_DELIVERY_MODE=console
OTP_EXPIRY_MINUTES=10
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INVITATION_TOKEN_EXPIRY_DAYS=90
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760