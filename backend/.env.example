FLASK_APP=run.py
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///instance/utsav.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OTP_DELIVERY_MODE=smtp
OTP_EXPIRY_MINUTES=10
# Keep this empty except for isolated development SMTP mail-sink testing.
OTP_FIXED_CODE=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_TOKEN_SECONDS=604800
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
RATE_LIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_HOPS=0
LOGIN_RATE_LIMIT=5 per minute
LOGIN_ACCOUNT_RATE_LIMIT=10 per hour
REGISTER_RATE_LIMIT=5 per hour
OTP_RATE_LIMIT=5 per 10 minutes
OTP_ACCOUNT_RATE_LIMIT=5 per hour
OTP_RESEND_RATE_LIMIT=3 per hour
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_LIMIT=3 per hour
PASSWORD_RESET_ACCOUNT_RATE_LIMIT=3 per day
PASSWORD_RESET_VERIFY_RATE_LIMIT=5 per hour
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
REFRESH_RATE_LIMIT=20 per minute
MFA_RATE_LIMIT=5 per 10 minutes
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=UTSAV
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INVITATION_TOKEN_EXPIRY_DAYS=90
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760